# InternNetra Backend Environment Configuration
PORT=5000

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@internnetra.com
SMTP_PASS=your_app_password_here
SMTP_FROM="InternNetra Team" <support@internnetra.com>

# Supabase Credentials
SUPABASE_URL=https://uvetznwcnsezyuxgjoou.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Cashfree Merchant Keys
CASHFREE_CLIENT_ID=your_cashfree_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret
CASHFREE_ENV=PRODUCTION

# AWS Infrastructure
AWS_REGION=ap-south-1

# IAM User
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# S3
AWS_S3_RAW_BUCKET=internnetra-lms-videos-prod-365957110532-ap-south-1-an
AWS_S3_HLS_BUCKET=internnetra-lms-videos-prod-365957110532-ap-south-1-an

# MediaConvert
AWS_MEDIACONVERT_ENDPOINT=https://mediaconvert.ap-south-1.amazonaws.com
AWS_MEDIACONVERT_ROLE_ARN=arn:aws:iam::365957110532:role/internnetra-lms-video-backend-role

# CloudFront
CLOUDFRONT_DISTRIBUTION_DOMAIN=https://d1234567890abcdef.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=K1234567890EXAMPLE
CLOUDFRONT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

